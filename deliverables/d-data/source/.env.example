# ARY D 组数据层环境变量样例。复制为 .env 后按需修改。
# 注意:本文件只被 config.py 读取,不写入系统环境变量(对齐 todos/04 §4 硬约束)。

# PostgreSQL 本地化连接(独立端口,避免污染系统默认 5432 实例)
ARY_PG_HOST=127.0.0.1
ARY_PG_PORT=5433
ARY_PG_DB=ary_data
ARY_PG_USER=ary
ARY_PG_PASSWORD=ary_local_dev

# conda 环境名
ARY_CONDA_ENV=SE

# 确定性种子(固定后整套数据可重复、可 diff;改动会改变生成结果)
ARY_RANDOM_SEED=20260614
ARY_FAKER_SEED=20260614
